# Copy to .env and fill in. Never commit .env.
# Local auth uses Application Default Credentials: `gcloud auth application-default login` (no key files).
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
# Used by the Streamlit front-end (set as a Hugging Face Space secret in production)
API_URL=http://localhost:8080
